{
  "name": "direct-recruit-backend",
  "version": "1.0.0",
  "description": "Backend API for Direct Recruit football recruiting platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:prod": "node scripts/run-prod-migration.js",
    "migrate:status": "node scripts/run-prod-migration.js --status",
    "migrate:dry-run": "node scripts/run-prod-migration.js --dry-run",
    "seed": "node scripts/seed-local.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.77.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.958.0",
    "@aws-sdk/client-s3": "^3.956.0",
    "@aws-sdk/client-ses": "^3.971.0",
    "@aws-sdk/s3-request-presigner": "^3.956.0",
    "bcrypt": "^6.0.0",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.6.11",
    "socket.io": "^4.6.2",
    "stripe": "^22.0.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
