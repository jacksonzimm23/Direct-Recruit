PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=direct_recruit
DB_USER=postgres
DB_PASSWORD=your_actual_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate limit overrides (OPTIONAL - both fall back to the committed defaults in
# middleware/rateLimit.js when unset, empty or unparseable). These exist so the
# two limiters that can hard-block onboarding can be retuned during a traffic
# event without a deploy: edit .env, then `pm2 restart direct-recruit --update-env`.
# Do NOT add these to REQUIRED_SECRETS in server.js - they must stay optional.
# RATE_API_MAX=10000    # apiLimiter, per IP per 15 min (default 2000)
# RATE_AUTH_MAX=2000    # authLimiter, per IP per 15 min (default 500)

# AWS Cognito (Authentication)
AWS_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
