NODE_ENV=development
PORT=5000

# Local PostgreSQL (Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=direct_recruit
DB_USER=postgres
DB_PASSWORD=localdev123

# Local Redis (Docker Compose) — optional, rate limiting is skipped in dev
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (local secret — does not need to match production)
JWT_SECRET=local-dev-jwt-secret-change-me

# Local dev verification code (used for all email/password verifications)
LOCAL_DEV_VERIFICATION_CODE=123456

# AI Features (optional — leave blank for mock responses, add key for real AI)
# ANTHROPIC_API_KEY=
# ANTHROPIC_PI_API_KEY=

# AWS credentials NOT needed in local dev — all services are mocked
# AWS_COGNITO_USER_POOL_ID=
# AWS_COGNITO_CLIENT_ID=
# AWS_COGNITO_CLIENT_SECRET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
# SES_FROM_EMAIL=
