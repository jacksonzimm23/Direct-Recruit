.env
.env.local
.env.production
*.env

# Node modules
node_modules/

# Build outputs
dist/
build/

# OS files
.DS_Store
Thumbs.db
nul

# IDE
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
backend/logs/

# Uploads (if local)
uploads/

# Temporary files
*.tmp
*.temp

# Sensitive business docs
cost-model.html
DEPLOYMENT-GUIDE.md
testing.md
pipeline.md
lessons.md
appcheck.md

# Local cookie/test auth jars — never commit (contain real JWTs)
cookies.txt
cookies_*.txt

# Admin dashboard (private, never commit)
frontend/admin/

# Capacitor native platforms (regenerate with npx cap add ios/android)
# Only ignore root-level ios/ and android/ folders, not icon subfolders
/ios/
/android/

# ...but track hand-edited iOS config files (Info.plist, entitlements, AppDelegate,
# PrivacyInfo manifest) so they survive cross-machine builds (Windows dev → Mac archive).
!ios/
!ios/App/
!ios/App/App/
!ios/App/App/Info.plist
!ios/App/App/App.entitlements
!ios/App/App/AppDelegate.swift
!ios/App/App/PrivacyInfo.xcprivacy

# PowerShell scripts (temporary/local)
*.ps1

# Remotion video project
video/

# Package lock (optional - can be committed if you want reproducible builds)
# package-lock.json

# APNs auth key (never commit)
*.p8
backend/keys/
